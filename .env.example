# =============================================================================
# Snowflake Credentials (nicht in Git!)
# =============================================================================
# Setup:
#   1. Diese Datei im Projekt-Root kopieren: cp .env.example .env
#   2. Account und User eintragen
#   3. Eine Auth-Methode wählen (unten einkommentieren)
#
# Die Variablen heissen SF_*. Ein Projekt aus dem Agentic-Engineering-Starter-
# Template darf stattdessen SNOWFLAKE_* verwenden (SNOWFLAKE_ACCOUNT, SNOWFLAKE_USER,
# SNOWFLAKE_PRIVATE_KEY_PATH); src/data_loader.py liest beide Schreibweisen.
# =============================================================================

SF_ACCOUNT=dein_account.eu-central-1
SF_USER=dein_username

# Umgebung: DEV, INT oder PROD. Einziger Schalter für Ziel-Datenbank ({env}_ML) und
# Quellen ({env}_DATALAKE...), siehe configs/config.yaml. Auf Laptops immer DEV.
ML_ENV=DEV

# Optional: Rolle, Warehouse und Schema kommen aus configs/config.yaml. Nur setzen,
# wenn du davon abweichen musst. Die Datenbank ({env}_ML) ist bewusst NICHT
# überschreibbar, damit ML_ENV der einzige Umgebungsschalter bleibt.
# SF_ROLE=ML_DEVELOPER
# SF_WAREHOUSE=CONSUMER
# SF_SCHEMA=INFERENCE

# =============================================================================
# Auth-Methode: genau EINE Zeile einkommentieren
# =============================================================================

# 1. Key-Pair (empfohlen: einmalig einrichten, kein MFA-Prompt)
#    openssl genrsa 2048 | openssl pkcs8 -topk8 -nocrypt -out ~/.snowflake/rsa_key.p8
#    openssl rsa -in ~/.snowflake/rsa_key.p8 -pubout -out ~/.snowflake/rsa_key.pub
#    Public Key in Snowflake hinterlegen (Admin): ALTER USER dein_user SET RSA_PUBLIC_KEY='...';
# SF_PRIVATE_KEY_PATH=~/.snowflake/rsa_key.p8

# 2. External Browser / SSO
# SF_AUTHENTICATOR=externalbrowser

# 3. Passwort (Fallback, kann MFA-Prompt auslösen)
# SF_PASSWORD=dein_passwort
