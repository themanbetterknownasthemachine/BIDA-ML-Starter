# =============================================================================
# BIDA ML Starter - .gitignore
# =============================================================================

# Python
__pycache__/
*.py[cod]
*.so
*.egg-info/
*.egg
dist/
build/

# Virtual environments
.venv/
env/

# Jupyter
.ipynb_checkpoints/
*.ipynb_checkpoints

# IDE
.vscode/
.idea/
*.code-workspace

# OS
.DS_Store
Thumbs.db

# Environment & Secrets
.env
*.p8
*.pem

# Claude Code (persoenliche Overrides, nicht im Team teilen)
.claude/settings.local.json
CLAUDE.local.md

# Data (zu gross für Git)
data/raw/*
data/processed/*
data/external/*
!data/raw/.gitkeep
!data/processed/.gitkeep
!data/external/.gitkeep

# Trained Models (zu gross für Git)
models/*
!models/.gitkeep

# Reports / Figures (optional tracken)
# reports/figures/*
# !reports/figures/.gitkeep

# uv.lock und requirements.txt werden committet (reproduzierbare Umgebung)

# Logs
*.log
logs/
lightning_logs/      # NeuralForecast / PyTorch Lightning Trainingslogs
.ruff_cache/

# pytest
.pytest_cache/
.coverage
htmlcov/

# mypy
.mypy_cache/
